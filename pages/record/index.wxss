/* pages/record/index.wxss — 报餐记录页样式（完善版） */

/* 筛选卡片 */
.filter-card {
  margin-bottom: 24rpx;
}

.filter-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 20rpx;
}

.filter-row {
  margin-bottom: 20rpx;
}

/* 小字灰色标签（时间区间 / 餐别） */
.filter-label-sm {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 12rpx;
}

/* 日期范围行 — 选择器 + 快捷同行 */
.date-range-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  padding: 0;
  margin-bottom: 12rpx;
}

.date-text {
  font-size: 26rpx;
  color: #374151;
  padding: 8rpx 16rpx;
  background: #f7fbff;
  border-radius: 8rpx;
  border: 1px solid #e3f0ff;
}

.date-sep {
  color: #9ca3af;
  font-size: 24rpx;
}

/* 快捷日期 — 文字链接风格 */
.quick-tags-inline {
  display: flex;
  gap: 10rpx;
  margin-left: 0;
}

.quick-link {
  font-size: 24rpx;
  margin-right: 20rpx;
  margin-top: 10rpx;
  color: #9ca3af;
  white-space: nowrap;
}

.quick-link.active {
  color: #1989fa;
  font-weight: 600;
}

.filter-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.filter-tag {
  font-size: 24rpx;
  color: #6b7280;
  padding: 8rpx 24rpx;
  background: #f7fbff;
  border-radius: 100rpx;
  border: 1px solid #e3f0ff;
}

.filter-tag.active {
  color: #1989fa;
  background: #eaf5ff;
  border-color: #1989fa;
  font-weight: 600;
}

/* 查询/重置按钮 — 底部居中 */
.filter-search {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
  overflow: hidden;
}

.reset-btn {
  color: #6b7280;
  border-color: #e5e7eb;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

/* 区间统计卡片 */
.summary-card {
  margin-bottom: 24rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
}

/* 统计维度切换 */
.stat-switch {
  display: flex;
  gap: 16rpx;
}

.stat-switch-item {
  font-size: 22rpx;
  color: #9ca3af;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  background: #f7fbff;
  border: 1px solid #e3f0ff;
}

.stat-switch-item.active {
  color: #1989fa;
  background: #eaf5ff;
  border-color: #1989fa;
  font-weight: 600;
}

.summary-body {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.summary-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-divider {
  width: 1rpx;
  background: #e5e7eb;
  margin: 0 8rpx;
}

.summary-meal {
  font-size: 26rpx;
  color: #6b7280;
}

.summary-qty {
  font-size: 32rpx;
  font-weight: 700;
  color: #374151;
}

.summary-sub {
  font-size: 22rpx;
  color: #9ca3af;
}

.summary-amount {
  font-size: 24rpx;
  color: #1989fa;
  font-weight: 600;
}

.summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1px solid #f0f1f3;
}

.summary-total-label {
  font-size: 26rpx;
  color: #9ca3af;
}

.summary-total-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
}

/* 核销进度（区间统计卡） */
.summary-verify {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 1px dashed #f0f1f3;
}

.summary-verify-item {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.summary-verify-item.ok {
  color: #07c160;
  background: #e8f9f0;
}

.summary-verify-item.no {
  color: #9ca3af;
  background: #f4f5f7;
}

/* ─── 记录列表 ─── */
/* 中间餐次行（早餐/午餐/晚餐）采用食堂端报餐明细的三段式分布 */
.record-list {
  margin-top: 24rpx;
}

/* 每日一张卡片（原样式） */
.record-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1px solid rgba(229, 231, 235, 0.7);
}

/* 头部：日期 + 星期（原样式） */
.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f0f1f3;
}

.record-date-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
}

.record-weekday {
  font-size: 22rpx;
  color: #1989fa;
  background: #eaf5ff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 餐次明细区（仅承载餐次行） */
.record-meal-body {
  margin-bottom: 8rpx;
}

/* 餐次行（三段式：餐别 | 份数+核销标签 | 金额） */
.record-meal-line {
  padding: 18rpx 0;
  border-bottom: 1px dashed #f0f1f3;
}

.record-meal-line:last-child {
  border-bottom: none;
}

.meal-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 餐别标签（圆点 + 文字） */
.meal-label-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 110rpx;
}

.meal-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.meal-dot--breakfast {
  background: #f5a623;
}

.meal-dot--lunch {
  background: #1989fa;
}

.meal-dot--dinner {
  background: #c8a6ff;
}

.meal-label-text {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

/* 份数 + 核销标签 */
.meal-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  justify-content: center;
}

.meal-qty {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.meal-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #1989fa;
  min-width: 120rpx;
  text-align: right;
}

/* 核销状态标签 */
.verify-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
  line-height: 1.4;
  white-space: nowrap;
  flex-shrink: 0;
}

.verify-tag-ok {
  color: #07c160;
  background: #e8f9f0;
}

.verify-tag-no {
  color: #9ca3af;
  background: #f4f5f7;
}

/* 核销明细（核销时间 / 核销人） */
.meal-verify-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 8rpx;
  padding-left: 28rpx;
}

.meal-verify-text {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 底部：当天合计 + 最后提交（原样式） */
.record-footer {
  padding-top: 16rpx;
  border-top: 1px solid #f0f1f3;
}

.record-footer-row {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.record-total {
  font-size: 24rpx;
  color: #374151;
  font-weight: 600;
}

.record-time {
  font-size: 22rpx;
  color: #9ca3af;
}

/* pages/index/index.wxss — 首页样式（对齐原型 EmployeeHome）
 * 卡片边距标准统一：padding ≡ 24rpx，margin-horizontal ≡ 32rpx，border-radius ≡ 24~28rpx
 */

/* notice-bar 通知条（全宽，与 hero 同宽） */
.notice-bar {
  margin: 0 0 20rpx;
}

/* ═══ 公告详情弹层 ═══ */
.notice-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.notice-pop {
  width: 620rpx;
  max-height: 72vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}
.notice-pop-head {
  flex-shrink: 0;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #f0f1f3;
}
.notice-pop-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8rpx;
}
.notice-pop-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
.notice-pop-body {
  flex: 1;
  min-height: 120rpx;
  max-height: 46vh;
  margin-top: 24rpx;
}
.notice-pop-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #374151;
  white-space: pre-wrap;
  word-break: break-all;
}
.notice-pop-close {
  flex-shrink: 0;
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #1989fa;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ═══ 报餐状态两栏布局 ═══ */
.meal-dual {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 0;
}
.meal-col {
  flex: 1;
  min-width: 0;
  margin: 0;
}
.meal-col-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 16rpx;
}
.meal-col-date {
  font-size: 20rpx;
  font-weight: 400;
  color: #9ca3af;
  margin-left: 8rpx;
}
.meal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1px solid #f0f1f3;
}
.meal-item:last-child {
  border-bottom: 0;
}
.meal-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.workspace-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: nowrap;
  margin-top: 20rpx;
  align-items: stretch;
}

/* 工作台按钮基础样式（与 profile 页一致） */
.workspace-tags .ws-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 12rpx 0;
  line-height: 1.3;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-all;
}

.workspace-tags .ws-btn-plain {
  background: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
}

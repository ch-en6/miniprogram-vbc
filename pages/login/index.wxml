<view class="login-page">
  <!-- Logo 区域 -->
  <view class="logo-area">
    <view class="logo-icon">餐</view>
    <text class="app-name">企业报餐</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <text class="login-title">欢迎使用</text>
    <text class="login-desc">请输入账号和密码登录</text>

    <!-- 账号密码登录表单 -->
    <view class="login-form">
      <van-field
        value="{{ phone }}"
        label="账号"
        placeholder="请输入手机号"
        type="number"
        maxlength="11"
        bind:change="onPhoneInput"
        left-icon="phone-o"
      />
      <van-field
        value="{{ password }}"
        label="密码"
        placeholder="请输入密码"
        type="password"
        bind:change="onPasswordInput"
        left-icon="lock"
      />
      <van-button
        type="primary"
        block
        round
        loading="{{ loading }}"
        disabled="{{ loading || phone.length !== 11 || !password }}"
        bindtap="onLogin"
        custom-class="btn-login"
      >登 录</van-button>
    </view>
  </view>

  <!-- 隐私提示 -->
  <view class="privacy-tip">
    <text>登录即表示同意</text>
    <text class="privacy-link" bindtap="showPrivacy">《用户隐私协议》</text>
  </view>

  <!-- Toast -->
  <van-toast id="van-toast" />
</view>

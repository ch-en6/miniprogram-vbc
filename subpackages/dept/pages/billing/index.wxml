<!-- subpackages/dept/pages/billing/index.wxml — 部门工作台 · 收费管理（独立页） -->

<view class="page-pad">

  <block wx:if="{{ hasPermission }}">

  <!-- 部门选择 -->
  <view class="dept-selector">
    <text class="dept-label">当前部门：</text>
    <picker mode="selector" range="{{ depts }}" range-key="dept_name" value="{{ currentDeptIndex }}" bindchange="onDeptChange">
      <text class="dept-picker">{{ depts[currentDeptIndex].dept_name }} ▾</text>
    </picker>
  </view>

  <!-- 月份选择 -->
  <view class="mini-card month-row">
    <text class="filter-label">选择月份</text>
    <picker mode="date" fields="month" value="{{ selectedMonth }}" end="{{ monthPickerEnd }}" bindchange="onMonthChange" class="month-picker">
      <view class="month-picker-box">
        <text class="month-picker-text">{{ selectedMonth }}</text>
        <van-icon name="calendar-o" size="32rpx" color="#969799" />
      </view>
    </picker>
    <van-button
      type="primary"
      size="small"
      custom-style="width:112rpx;height:58rpx;padding:0;margin-left:16rpx;font-size:26rpx;flex-shrink:0;box-sizing:border-box;line-height:58rpx;"
      bindtap="onQuery"
    >查询</van-button>
  </view>

  <!-- 查询加载态 -->
  <view class="loading-wrap" wx:if="{{ billingLoading }}">
    <van-loading type="spinner" color="#1989fa" size="24px">查询中...</van-loading>
  </view>

  <!-- 导出按钮（表格上方，与统计页一致） -->
  <view class="export-bar" wx:if="{{ billingList.length > 0 }}">
    <van-button type="primary" plain block icon="down" bindtap="onExportBilling">导出 Excel 报表</van-button>
  </view>

  <!-- 收费明细表 -->
  <view class="mini-card billing-card" wx:if="{{ billingList.length > 0 }}">
    <view class="billing-title">收费明细表 <text class="title-small">（{{ selectedMonth }}）</text></view>
    <scroll-view scroll-x class="billing-scroll">
      <view class="billing-table">
        <view class="tr th">
          <text class="td">序号</text>
          <text class="td">姓名</text>
          <text class="td">餐别</text>
          <text class="td">总餐数</text>
          <text class="td">家属数</text>
          <text class="td">员工价</text>
          <text class="td">家属价</text>
          <text class="td">员工金额</text>
          <text class="td">家属金额</text>
          <text class="td">总金额</text>
        </view>
        <view class="tr" wx:for="{{ billingList }}" wx:key="id">
          <text class="td">{{ index + 1 }}</text>
          <text class="td">{{ item.name }}</text>
          <text class="td">{{ item.mealLabel }}</text>
          <text class="td">{{ item.qty }}</text>
          <text class="td">{{ item.family }}</text>
          <text class="td">¥{{ item.empPrice }}</text>
          <text class="td">¥{{ item.familyPrice }}</text>
          <text class="td">¥{{ item.empAmount }}</text>
          <text class="td">¥{{ item.famAmount }}</text>
          <text class="td td-amount">¥{{ item.amount }}</text>
        </view>
        <view class="tr tfoot">
          <text class="td td-footer-label">汇总</text>
          <text class="td td-amount">¥ {{ totalAmount }}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <van-empty wx:if="{{ !billingLoading && billingList.length === 0 && hasQueried }}" description="暂无收费数据" />
  <van-empty wx:if="{{ !billingLoading && !hasQueried }}" description="请选择月份并点击查询" />

  </block>

  <!-- 无部门权限时显示空态 -->
  <van-empty wx:else description="当前账号暂无管理的部门" image="search" />
</view>

<dept-tabbar active="billing" />
<van-toast id="van-toast" />

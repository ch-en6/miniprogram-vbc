/* subpackages/dept/pages/billing/index.wxss — 月度收费统计页样式 */
.page-container {
  padding: 20rpx 24rpx 40rpx;
  min-height: 100vh;
  background: #f7f8fa;
}

/* 部门选择器 */
.dept-selector {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dept-label {
  font-size: 28rpx;
  color: #323233;
  margin-right: 16rpx;
}
.dept-picker {
  font-size: 28rpx;
  color: #1989fa;
  font-weight: 500;
}

/* 月份选择器 */
.month-selector {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.filter-label {
  font-size: 28rpx;
  color: #323233;
  margin-right: 16rpx;
  white-space: nowrap;
}
.month-picker {
  flex: 1;
  font-size: 28rpx;
  color: #1989fa;
  margin-right: 16rpx;
}
.query-btn {
  margin-left: auto;
}

/* 快照状态栏 */
.snapshot-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.snapshot-info {
  font-size: 22rpx;
  color: #969799;
  margin-left: 12rpx;
  flex: 1;
}

/* 收费明细表 */
.billing-table {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}
.title-line {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 20rpx;
}
.title-line small {
  font-size: 24rpx;
  font-weight: 400;
  color: #969799;
  margin-left: 8rpx;
}

/* 表格 */
.table-header,
.table-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ebedf0;
}
.table-header {
  font-size: 22rpx;
  color: #969799;
  font-weight: 500;
  background: #fafafa;
  margin: 0 -24rpx;
  padding: 16rpx 24rpx;
}
.table-row {
  font-size: 24rpx;
  color: #323233;
}

.col-seq {
  width: 60rpx;
  text-align: center;
  flex-shrink: 0;
}
.col-name {
  width: 80rpx;
  flex-shrink: 0;
}
.col-meal {
  width: 80rpx;
  flex-shrink: 0;
}
.col-qty {
  width: 70rpx;
  text-align: center;
  flex-shrink: 0;
}
.col-price {
  width: 100rpx;
  text-align: right;
  flex-shrink: 0;
}
.col-family {
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}
.col-emp-amount {
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
}
.col-fam-amount {
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
}
.col-amount {
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
  font-weight: 600;
}
.amount-highlight {
  color: #ee0a24;
}

/* 汇总行 */
.table-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 0;
  margin-top: 16rpx;
  border-top: 2rpx solid #323233;
}
.footer-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}
.footer-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #ee0a24;
}

/* 导出按钮 */
.export-bar {
  padding: 0 0 20rpx;
}

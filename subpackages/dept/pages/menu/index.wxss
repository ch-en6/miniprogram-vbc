/* subpackages/dept/pages/menu/index.wxss — 菜单配置页 */

page {
  background: #f5f6f8;
  --brand: #1989fa;
  --brand-dark: #0570db;
  --text-1: #323233;
  --text-2: #646566;
  --text-3: #969799;
  --line: #ebedf0;
}

/* 页面容器：底部为固定 Tab 栏预留空间 */
.page-pad {
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* ── 食堂选择（与员工页「当前部门」同款） ── */
.dept-selector {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.dept-label {
  font-size: 26rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}

.dept-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

/* 当前所选食堂已停用时的提示标签（对齐 sys-config 页 .dept-disabled-tag） */
.dept-disabled-tag {
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
  background: #f2f3f5;
  color: #969799;
  font-weight: 400;
}

.dept-picker-arrow {
  font-size: 24rpx;
  line-height: 1;
  color: var(--text-3);
}

/* ── 操作工具卡（白卡 + 蓝色按钮，风格对齐员工/统计/收费页） ── */
.tool-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tool-tip {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

.tool-actions {
  display: flex;
  gap: 20rpx;
}

.ws-btn-style {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.3;
  border-radius: 8rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
  background: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
}

.ws-btn-style-hover {
  background: #ecf5ff;
}

/* 停用食堂：新增按钮置灰禁用（与员工页 .ws-btn-style-disabled 完全一致） */
.ws-btn-style-disabled {
  background: #f7f8fa;
  color: #c8c9cc;
  border-color: #e5e5e5;
}

/* ── 菜单计划列表 ── */
.plan-list {
  margin-top: 8rpx;
}

.plan-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-badges {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.plan-name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 状态胶囊：浅底深字全圆角（与员工页 badge 同风格） */
.badge {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.badge-green {
  background: #e8f7ef;
  color: #07c160;
}

.badge-gray {
  background: #f2f3f5;
  color: #969799;
}

/* 当前生效：主色实心，列表中最高优先级 */
.badge-active {
  background: #1989fa;
  color: #fff;
}

/* 有效期内但本轮未轮到（多张计划有效期重叠时出现）：浅蓝，弱于生效态 */
.badge-blue {
  background: #eaf3ff;
  color: #1989fa;
}

/* 已启用但开始日期在未来：浅橙 */
.badge-orange {
  background: #fff7e8;
  color: #ff976a;
}

/* 已过结束日期：浅灰 */
.badge-red {
  background: #f2f3f5;
  color: #969799;
}

.plan-period {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.plan-period-text {
  font-size: 26rpx;
  color: var(--text-3);
}

.plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.plan-count {
  font-size: 24rpx;
  color: var(--text-3);
}

.plan-btns {
  display: flex;
  gap: 16rpx;
}

/* 列表操作按钮：样式对齐「新增员工」（方形白底 + 1px 蓝框 + 蓝字） */
.list-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.3;
  border-radius: 8rpx;
  padding: 12rpx 30rpx;
  box-sizing: border-box;
  background: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
  white-space: nowrap;
}

.list-btn-hover {
  background: #ecf5ff;
}

.list-btn-danger {
  color: #ee0a24;
  border-color: #ee0a24;
}

.list-btn-danger-hover {
  background: #fef0f0;
}

/* 空 / 加载中 */
.list-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}

/* 有列表但无生效计划时的说明行 */
.list-hint {
  margin-top: 4rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-3);
}

.list-empty,
.no-perm {
  padding: 40rpx 0 0;
}

/* ─────────── 表单弹窗（底部弹出） ─────────── */
.form-sheet {
  background: #fff;
  padding: 32rpx 0 0;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.form-title {
  flex-shrink: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 24rpx;
}

/* 中间滚动区：名称/日期/启用/菜品网格都在这里滚 */
.form-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.form-loading {
  display: block;
  text-align: center;
  padding: 60rpx 0;
}

.form-group {
  margin: 0 24rpx 16rpx !important;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 0 24rpx 16rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-1);
  flex-shrink: 0;
}

.form-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-picker-text {
  font-size: 28rpx;
  line-height: 1;
  color: var(--text-1);
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-picker-arrow {
  font-size: 24rpx;
  line-height: 1;
  color: var(--text-3);
}

/* ── 菜品安排 ── */
.dish-title {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 24rpx 32rpx 12rpx;
}

.dish-tabs {
  margin: 0 24rpx;
}

.dish-body {
  padding: 16rpx 0;
}

.form-actions {
  flex-shrink: 0;
  display: flex;
  gap: 24rpx;
  padding: 16rpx 24rpx 24rpx;
  border-top: 1rpx solid var(--line);
  background: #fff;
}

/* 表单按钮（van-button）：等分并排 */
.form-btn {
  flex: 1;
}

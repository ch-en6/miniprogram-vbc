<!-- subpackages/dept/pages/profile/index.wxml — 部门工作台 · 我的 -->
<view class="page-pad">

  <!-- 员工信息卡片 -->
  <view class="emp-card">
    <view class="emp-card-header">
      <view class="emp-avatar">
        <text class="emp-avatar-text">{{ userInfo.name ? userInfo.name[0] : '?' }}</text>
      </view>
      <view class="emp-header-info">
        <text class="emp-name">{{ userInfo.name || '—' }}</text>
        <view class="emp-dept">{{ deptName || '—' }}</view>
        <!-- <view class="emp-role-tag">{{ roleName }}</view> -->
      </view>
    </view>

    <view class="emp-card-body">
      <view class="emp-info-row">
        <text class="emp-label">手机号</text>
        <view class="emp-phone-row">
          <text class="emp-value">{{ phoneMasked }}</text>
          <text class="rebind-link" bindtap="toggleRebind">换绑</text>
        </view>
      </view>
      <view class="emp-info-row" bindtap="toggleChangePwd">
        <text class="emp-label">修改密码</text>
        <view class="pwd-arrow">
          <van-icon name="arrow" size="16px" color="#c0c4cc" />
        </view>
      </view>
      <!-- <view class="emp-info-row">
        <text class="emp-label">微信绑定</text>
        <text class="emp-value">已绑定</text>
      </view> -->
    </view>
  </view>

  <!-- 工作台切换（仅部门管理员/系统管理员可见） -->
  <view class="mini-card" wx:if="{{ showWorkspace }}">
    <view class="section-title" style="margin-top: 0;">工作台</view>
    <view class="workspace-tags">
      <view class="ws-btn ws-btn-plain" bindtap="goEmployee">员工端</view>
      <view class="ws-btn ws-btn-plain" bindtap="goKitchenWorkbench">食堂工作台</view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-card" bindtap="logout">
    <text class="logout-text">退出登录</text>
  </view>

  <!-- 换绑手机号弹窗 -->
  <view class="phone-modal" wx:if="{{ showRebind }}">
    <view class="phone-modal-card">
      <view class="modal-head">
        <text class="modal-title">换绑手机号</text>
        <van-icon name="cross" bindtap="toggleRebind" />
      </view>
      <view class="muted rebind-tip">如需换绑手机号，请先联系部门管理员。</view>
      <van-cell-group inset>
        <van-field label="当前手机号" value="{{ phoneMasked }}" readonly />
        <!-- <van-field label="新手机号" placeholder="请输入新手机号" value="{{ newPhone }}" bind:change="onNewPhoneInput" />
        <van-field label="验证码" placeholder="请输入验证码" value="{{ smsCode }}" bind:change="onSmsInput">
          <view slot="button">
            <van-button size="small" type="primary" bindtap="sendSmsCode" disabled="{{ smsCooldown > 0 }}" custom-class="sms-btn-mini">
              {{ smsCooldown > 0 ? smsCooldown + 's' : '获取验证码' }}
            </van-button>
          </view>
        </van-field> -->
      </van-cell-group>
      <!-- <view class="btn-row">
        <van-button type="primary" block round bindtap="confirmRebind">确认换绑</van-button>
      </view> -->
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <view class="phone-modal" wx:if="{{ showChangePwd }}">
    <view class="phone-modal-card">
      <view class="modal-head">
        <text class="modal-title">修改密码</text>
        <van-icon name="cross" bindtap="toggleChangePwd" />
      </view>
      <van-cell-group inset>
        <van-field
          label="旧密码"
          type="password"
          placeholder="请输入旧密码"
          value="{{ oldPwd }}"
          bind:change="onOldPwdInput"
        />
        <van-field
          label="新密码"
          type="password"
          placeholder="请输入新密码（至少8位）"
          value="{{ newPwd }}"
          bind:change="onNewPwdInput"
        />
        <van-field
          label="确认密码"
          type="password"
          placeholder="请再次输入新密码"
          value="{{ confirmPwd }}"
          bind:change="onConfirmPwdInput"
        />
      </van-cell-group>
      <view class="btn-row" style="margin-top:24rpx;">
        <van-button type="primary" block round loading="{{ pwdLoading }}" bindtap="confirmChangePwd">确认修改</van-button>
      </view>
    </view>
  </view>

  <!-- Vant Dialog 组件 -->
  <van-dialog id="van-dialog" />
</view>

<!-- 底部导航：员工 / 统计 / 收费 / 我的 -->
<dept-tabbar active="profile" />

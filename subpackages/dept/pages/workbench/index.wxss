/* subpackages/dept/pages/workbench/index.wxss — 部门工作台 · 配置 */
.page-pad {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #f5f6f8;
}

/* ═══ 功能宫格 ═══ */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-item {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc((100% - 20rpx) / 2);
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.05);
}

.grid-item-hover {
  background: #f2f3f5;
}

.grid-item .gi-icon {
  font-size: 56rpx;
  line-height: 1;
}

.grid-item .gi-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}
<!-- subpackages/dept/pages/workspace/index.wxml — 部门管理员工作台
     严格对齐原型：4 Tab（员工/统计/收费/我的），van-tabbar，无 Hero 卡片 -->

<!-- ============== Tab 1: 员工 ============== -->
<view class="page-pad" wx:if="{{ activeTab === 'm-staff' }}">

  <!-- 部门选择 -->
  <view class="dept-selector">
    <text class="dept-label">当前部门：</text>
    <picker mode="selector" range="{{ departmentNames }}" value="{{ currentDeptIndex }}" bindchange="onDeptChange">
      <text class="dept-picker">{{ departmentNames[currentDeptIndex] }} ▾</text>
    </picker>
  </view>

  <!-- 搜索栏 -->
  <van-search
    value="{{ searchKey }}"
    placeholder="搜索姓名/手机号"
    shape="round"
    bind:search="onStaffSearch"
    bind:clear="onStaffClear"
  />

  <!-- 操作按钮 -->
  <view class="mini-actions">
    <van-button size="small" type="primary" icon="plus" bindtap="onAddStaff">新增员工</van-button>
    <van-button size="small" plain type="primary" icon="description-o" bindtap="onBatchImport">批量导入</van-button>
  </view>

  <!-- 员工列表 -->
  <view class="staff-list">
    <view class="staff-item" wx:for="{{ staffList }}" wx:key="id">
      <view class="staff-info">
        <text class="staff-name">{{ item.name }}</text>
        <text class="staff-phone">{{ item.phone }}</text>
        <text class="staff-dept">{{ item.department }}</text>
      </view>
      <view class="staff-status">
        <van-tag type="{{ item.status === 'active' ? 'success' : 'danger' }}" size="small">
          {{ item.status === 'active' ? '启用' : '禁用' }}
        </van-tag>
        <van-tag type="{{ item.wechatBound ? 'primary' : 'default' }}" size="small" custom-class="ml-4">
          {{ item.wechatBound ? '已绑定' : '未绑定' }}
        </van-tag>
      </view>
      <view class="staff-actions">
        <text class="action-link" bindtap="onEditStaff" data-id="{{ item.id }}">编辑</text>
        <text class="action-link danger" bindtap="onToggleStatus" data-id="{{ item.id }}" data-status="{{ item.status }}">
          {{ item.status === 'active' ? '禁用' : '启用' }}
        </text>
        <text class="action-link" bindtap="onChangePhone" data-id="{{ item.id }}">改手机号</text>
        <text class="action-link" wx:if="{{ item.wechatBound }}" bindtap="onUnbindWechat" data-id="{{ item.id }}">解绑</text>
      </view>
    </view>
  </view>

  <van-empty wx:if="{{ staffList.length === 0 }}" description="暂无员工数据" />
</view>

<!-- ============== Tab 2: 统计 ============== -->
<view class="page-pad" wx:if="{{ activeTab === 'm-stats' }}">

  <!-- 部门选择 -->
  <view class="dept-selector">
    <text class="dept-label">当前部门：</text>
    <picker mode="selector" range="{{ departmentNames }}" value="{{ currentDeptIndex }}" bindchange="onDeptChange">
      <text class="dept-picker">{{ departmentNames[currentDeptIndex] }} ▾</text>
    </picker>
  </view>

  <!-- 明日报餐汇总卡片 -->
  <view class="mini-card">
    <view class="title-line">明日报餐汇总 <text class="title-small">（截至今日）</text></view>
    <view class="stat-grid">
      <view class="stat">
        <text class="stat-num">{{ tomorrowStat.breakfast }}</text>
        <text class="stat-label">早餐</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{ tomorrowStat.lunch }}</text>
        <text class="stat-label">午餐</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{ tomorrowStat.dinner }}</text>
        <text class="stat-label">晚餐</text>
      </view>
    </view>
  </view>

  <!-- 筛选条件 -->
  <view class="filter-card mini-card">
    <view class="filter-title">统计筛选</view>
    <view class="filter-row">
      <text class="filter-label">日期范围</text>
      <view class="filter-value">
        <picker mode="date" value="{{ startDate }}" bindchange="onStartDateChange">
          <text class="date-input">{{ startDate }}</text>
        </picker>
        <text class="date-sep">至</text>
        <picker mode="date" value="{{ endDate }}" bindchange="onEndDateChange">
          <text class="date-input">{{ endDate }}</text>
        </picker>
      </view>
    </view>
    <van-button type="primary" size="small" bindtap="onSearch" custom-class="mt-10">查询</van-button>
  </view>

  <!-- 统计列表 -->
  <view class="stat-list">
    <view class="stat-item" wx:for="{{ statList }}" wx:key="date">
      <view class="stat-header">{{ item.date }}</view>
      <view class="stat-detail">
        <view class="stat-meal">
          <text class="meal-name">早餐</text>
          <text class="meal-qty">{{ item.breakfast }}</text> 份
          <text class="meal-family" wx:if="{{ item.breakfastFamily > 0 }}">（家属 {{ item.breakfastFamily }} 份）</text>
        </view>
        <view class="stat-meal">
          <text class="meal-name">午餐</text>
          <text class="meal-qty">{{ item.lunch }}</text> 份
          <text class="meal-family" wx:if="{{ item.lunchFamily > 0 }}">（家属 {{ item.lunchFamily }} 份）</text>
        </view>
        <view class="stat-meal">
          <text class="meal-name">晚餐</text>
          <text class="meal-qty">{{ item.dinner }}</text> 份
          <text class="meal-family" wx:if="{{ item.dinnerFamily > 0 }}">（家属 {{ item.dinnerFamily }} 份）</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 导出按钮 -->
  <view class="export-bar">
    <van-button type="primary" plain block bindtap="onExport">导出 Excel 报表</van-button>
  </view>

  <van-empty wx:if="{{ statList.length === 0 }}" description="暂无统计数据" />
</view>

<!-- ============== Tab 3: 收费 ============== -->
<view class="page-pad" wx:if="{{ activeTab === 'm-billing' }}">

  <!-- 部门选择 -->
  <view class="dept-selector">
    <text class="dept-label">当前部门：</text>
    <picker mode="selector" range="{{ departmentNames }}" value="{{ currentDeptIndex }}" bindchange="onDeptChange">
      <text class="dept-picker">{{ departmentNames[currentDeptIndex] }} ▾</text>
    </picker>
  </view>

  <!-- 月份选择 -->
  <view class="mini-card month-row">
    <text class="filter-label">选择月份</text>
    <picker mode="date" fields="month" value="{{ selectedMonth }}" bindchange="onMonthChange">
      <text class="date-input month-input">{{ selectedMonth }}</text>
    </picker>
    <van-button type="primary" size="small" bindtap="onQuery">查询</van-button>
  </view>

  <!-- 快照状态标识 -->
  <view class="snapshot-bar snapshot-blue" wx:if="{{ hasQueried && isSnapshot }}">
    <van-tag type="primary" size="small">已快照</van-tag>
    <text class="snapshot-text">快照月份：{{ snapshotMonth }}｜生成时间：{{ snapshotTime }}｜操作人：{{ snapshotBy }}</text>
  </view>
  <view class="snapshot-bar snapshot-yellow" wx:if="{{ hasQueried && !isSnapshot }}">
    <van-tag type="warning" size="small">实时查询</van-tag>
    <text class="snapshot-text">当前数据为实时计算结果，尚未生成快照</text>
  </view>

  <!-- 收费明细表 -->
  <view class="mini-card billing-card" wx:if="{{ billingList.length > 0 }}">
    <view class="billing-title">收费明细表 <text class="title-small">（{{ selectedMonth }}）</text></view>
    <scroll-view scroll-x class="billing-scroll">
      <view class="billing-table">
        <view class="tr th">
          <text class="td">序号</text>
          <text class="td">姓名</text>
          <text class="td">餐别</text>
          <text class="td">餐数</text>
          <text class="td">标准价</text>
          <text class="td">家属数</text>
          <text class="td">员工金额</text>
          <text class="td">家属金额</text>
          <text class="td">总金额</text>
        </view>
        <view class="tr" wx:for="{{ billingList }}" wx:key="id">
          <text class="td">{{ index + 1 }}</text>
          <text class="td">{{ item.name }}</text>
          <text class="td">{{ item.mealLabel }}</text>
          <text class="td">{{ item.qty }}</text>
          <text class="td">¥{{ item.empPrice }}</text>
          <text class="td">{{ item.family }}</text>
          <text class="td">¥{{ item.empAmount }}</text>
          <text class="td">¥{{ item.famAmount }}</text>
          <text class="td td-amount">¥{{ item.amount }}</text>
        </view>
        <view class="tr tfoot">
          <text class="td td-footer-label">汇总</text>
          <text class="td td-amount">¥ {{ totalAmount }}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 导出按钮 -->
  <view class="export-bar" wx:if="{{ billingList.length > 0 }}">
    <van-button type="primary" plain block icon="down" bindtap="onExportBilling">导出 Excel 报表</van-button>
  </view>

  <van-empty wx:if="{{ billingList.length === 0 && hasQueried }}" description="暂无收费数据" />
  <van-empty wx:if="{{ !hasQueried }}" description="请选择月份并点击查询" />
</view>

<!-- ============== Tab 4: 我的 ============== -->
<view class="page-pad" wx:if="{{ activeTab === 'm-profile' }}">
  <van-cell-group inset title="个人中心">
    <van-cell title="姓名" value="{{ userInfo.name || '—' }}" />
    <van-cell title="手机号" value="{{ phoneMasked }}" />
    <van-cell title="部门" value="{{ userInfo.dept || '—' }}" />
    <van-cell title="当前角色" value="{{ roleName }}" />
    <van-cell title="微信绑定" value="已绑定" />
  </van-cell-group>

  <view class="btn-block">
    <van-button block round plain type="primary" bindtap="toggleRebind">换绑手机号</van-button>
  </view>

  <view class="mini-card">
    <view class="section-title">工作台切换</view>
    <view class="workspace-tags">
      <van-button size="small" type="primary" bindtap="goEmployee">员工端</van-button>
    </view>
  </view>

  <!-- 换绑手机号弹窗 -->
  <view class="phone-modal" wx:if="{{ showRebind }}">
    <view class="phone-modal-card">
      <view class="modal-head">
        <text>换绑手机号</text>
        <van-icon name="cross" bindtap="toggleRebind" />
      </view>
      <view class="muted rebind-tip">新手机号必须已存在于员工列表，且未绑定其他微信。如需换绑手机号，请先联系部门管理员。</view>
      <van-cell-group inset>
        <van-cell title="当前手机号" value="{{ phoneMasked }}" />
        <van-field label="新手机号" placeholder="请输入新手机号" value="{{ newPhone }}" bind:change="onNewPhoneInput" />
        <van-field label="验证码" placeholder="请输入验证码" value="{{ smsCode }}" bind:change="onSmsInput">
          <view slot="button">
            <van-button size="small" type="primary" bindtap="sendSmsCode" disabled="{{ smsCooldown > 0 }}">
              {{ smsCooldown > 0 ? smsCooldown + 's' : '获取验证码' }}
            </van-button>
          </view>
        </van-field>
      </van-cell-group>
      <view class="btn-block">
        <van-button type="primary" block round bindtap="confirmRebind">确认换绑</van-button>
      </view>
    </view>
  </view>
</view>

<!-- ============== 底部 Tab 栏（Vant Tabbar） ============== -->
<van-tabbar active="{{ activeTab }}" active-color="#1989fa" inactive-color="#7b8794" bind:change="onTabbarChange">
  <van-tabbar-item name="m-staff" icon="friends-o">员工</van-tabbar-item>
  <van-tabbar-item name="m-stats" icon="chart-trending-o">统计</van-tabbar-item>
  <van-tabbar-item name="m-billing" icon="bill-o">收费</van-tabbar-item>
  <van-tabbar-item name="m-profile" icon="manager-o">我的</van-tabbar-item>
</van-tabbar>

<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

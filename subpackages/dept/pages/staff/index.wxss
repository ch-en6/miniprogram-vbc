/* subpackages/dept/pages/staff/index.wxss — 员工管理页样式 */

.page-container {
  min-height: 100vh;
  background: #f4f6f9;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 部门选择器 */
.dept-selector {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1px solid #f0f1f3;
}

.dept-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-right: 16rpx;
}

.dept-picker {
  font-size: 28rpx;
  color: #1989fa;
  font-weight: 600;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1px solid #f0f1f3;
}

/* 员工列表 */
.staff-list {
  padding: 16rpx 24rpx 0;
}

.staff-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1px solid rgba(229, 231, 235, 0.7);
}

.staff-info {
  margin-bottom: 12rpx;
}

.staff-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 8rpx;
}

.staff-phone {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.staff-dept {
  font-size: 24rpx;
  color: #9ca3af;
}

.staff-status {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.staff-actions {
  display: flex;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f0f1f3;
}

.action-link {
  font-size: 24rpx;
  color: #1989fa;
}

.action-link.danger {
  color: #ee0a24;
}

/* 弹窗 */
.modal-card {
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 32rpx;
  text-align: center;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-actions van-button {
  flex: 1;
}

/* 加载状态 */
.load-more, .no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #1989fa;
}

.no-more {
  color: #ccc;
}

/* 批量导入预览弹窗（Phase 4.5 增强） */
.import-summary {
  font-size: 26rpx;
  color: #323233;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.import-error-count {
  color: #ee0a24;
  font-weight: 600;
}

.import-list {
  max-height: 600rpx;
  overflow-y: auto;
  margin-bottom: 24rpx;
}

.import-item {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1px solid #e5e7eb;
}

.import-item-error {
  background: #fff5f5;
  border-color: #ee0a24;
}

.import-row-index {
  font-size: 22rpx;
  color: #969799;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.import-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.import-label {
  font-size: 24rpx;
  color: #6b7280;
  width: 120rpx;
}

.import-value {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
}

.import-error-detail {
  font-size: 22rpx;
  color: #ee0a24;
  margin-top: 12rpx;
  padding: 12rpx;
  background: #fff;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.error-text {
  flex: 1;
  line-height: 1.5;
}

<!-- subpackages/dept/pages/staff/index.wxml — 员工管理页 -->
<view class="page-container">

  <!-- 部门选择（部门管理员可管理多个部门） -->
  <view class="dept-selector" wx:if="{{departments.length > 1}}">
    <text class="dept-label">当前部门：</text>
    <picker mode="selector" range="{{departmentNames}}" value="{{currentDeptIndex}}" bindchange="onDeptChange">
      <view class="dept-picker">{{departmentNames[currentDeptIndex]}} ▾</view>
    </picker>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <van-search
      value="{{ searchKey }}"
      placeholder="搜索姓名/手机号"
      bind:search="onSearch"
      bind:clear="onClearSearch"
    />
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <van-button type="primary" size="small" bindtap="onAddStaff">新增员工</van-button>
    <van-button type="default" size="small" bindtap="onBatchImport">批量导入</van-button>
  </view>

  <!-- 员工列表 -->
  <view class="staff-list">
    <view class="staff-item" wx:for="{{staffList}}" wx:key="id">
      <view class="staff-info">
        <view class="staff-name">{{item.name}}</view>
        <view class="staff-phone">{{item.phone}}</view>
        <view class="staff-dept">{{item.department}}</view>
      </view>
      <view class="staff-status">
        <van-tag type="{{item.status === 'active' ? 'success' : 'danger'}}" size="small">
          {{item.status === 'active' ? '启用' : '禁用'}}
        </van-tag>
        <van-tag type="{{item.wechatBound ? 'primary' : 'default'}}" size="small" style="margin-left: 8rpx;">
          {{item.wechatBound ? '已绑定' : '未绑定'}}
        </van-tag>
      </view>
      <view class="staff-actions">
        <text class="action-link" bindtap="onEditStaff" data-id="{{item.id}}">编辑</text>
        <text class="action-link danger" bindtap="onToggleStatus" data-id="{{item.id}}" data-status="{{item.status}}">
          {{item.status === 'active' ? '禁用' : '启用'}}
        </text>
        <text class="action-link" bindtap="onChangePhone" data-id="{{item.id}}">改手机号</text>
        <text class="action-link" bindtap="onUnbindWechat" data-id="{{item.id}}" wx:if="{{item.wechatBound}}">解绑</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <van-empty wx:if="{{staffList.length === 0 && !loading}}" description="暂无员工数据" />

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <van-loading size="24rpx" /> 加载中...
  </view>
  <view class="no-more" wx:if="{{!hasMore && staffList.length > 0}}">没有更多了</view>
</view>

<!-- 批量导入预览弹窗（Phase 4.5 增强错误展示） -->
<van-popup
  show="{{showImportModal}}"
  position="bottom"
  round
  style="height: 80%;"
  bind:close="onCloseImportModal"
>
  <view class="modal-card" style="height: 100%; display: flex; flex-direction: column;">
    <view class="modal-title">批量导入预览</view>

    <!-- 错误汇总 -->
    <view class="import-summary" wx:if="{{importList.length > 0}}">
      <text>共 {{importList.length}} 条</text>
      <text wx:if="{{importErrorCount > 0}}" class="import-error-count">，{{importErrorCount}} 条有误</text>
      <text>，{{importValidCount}} 条可导入</text>
    </view>

    <!-- 导入列表 -->
    <scroll-view scroll-y style="flex: 1; max-height: 60vh;">
      <view class="import-list">
        <view class="import-item {{item.error ? 'import-item-error' : ''}}" wx:for="{{importList}}" wx:key="index">
          <view class="import-row-index">第 {{index + 2}} 行</view>
          <view class="import-row">
            <text class="import-label">姓名：</text>
            <text class="import-value">{{item.name || '（空）'}}</text>
          </view>
          <view class="import-row">
            <text class="import-label">手机号：</text>
            <text class="import-value">{{item.phone || '（空）'}}</text>
          </view>
          <view class="import-row">
            <text class="import-label">部门：</text>
            <text class="import-value">{{item.department || '（空）'}}</text>
          </view>
          <view class="import-error-detail" wx:if="{{item.error}}">
            <van-icon name="warning-o" color="#ee0a24" />
            <text class="error-text">{{item.error}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 操作按钮 -->
    <view class="modal-actions" style="padding: 24rpx; border-top: 1rpx solid #ebedf0;">
      <van-button type="default" bindtap="onCloseImportModal">取消</van-button>
      <van-button type="primary" bindtap="onConfirmImport" loading="{{importLoading}}" disabled="{{importValidCount === 0}}">
        确认导入（{{importValidCount}} 条）
      </van-button>
    </view>
  </view>
</van-popup>

<!-- 新增/编辑员工弹窗 -->
<van-popup
  show="{{showStaffModal}}"
  position="bottom"
  round
  bind:close="onCloseStaffModal"
>
  <view class="modal-card">
    <view class="modal-title">{{editMode ? '编辑员工' : '新增员工'}}</view>
    <van-field
      value="{{formData.name}}"
      label="姓名"
      placeholder="请输入姓名"
      bind:change="onFormInput"
      data-field="name"
    />
    <van-field
      value="{{formData.phone}}"
      label="手机号"
      placeholder="请输入手机号"
      type="number"
      maxlength="11"
      bind:change="onFormInput"
      data-field="phone"
    />
    <van-field
      value="{{formData.department}}"
      label="部门"
      placeholder="请选择部门"
      disabled
      bind:click-input="onSelectDept"
    />
    <van-field
      value="{{formData.role}}"
      label="角色"
      placeholder="请选择角色"
      disabled
      bind:click-input="onSelectRole"
    />
    <view class="modal-actions">
      <van-button type="default" bindtap="onCloseStaffModal">取消</van-button>
      <van-button type="primary" bindtap="onSaveStaff">保存</van-button>
    </view>
  </view>
</van-popup>

<!-- Toast -->
<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

<!-- subpackages/dept/pages/staff/index.wxml — 部门工作台 · 员工管理 -->

<view class="page-pad">

  <!-- 部门选择 + 权限提示 -->
  <view class="dept-selector" wx:if="{{ hasPermission }}">
    <text class="dept-label">当前部门：</text>
    <picker
      mode="selector"
      range="{{ depts }}"
      range-key="dept_name"
      value="{{ currentDeptIndex }}"
      bindchange="onDeptChange"
    >
      <view class="dept-picker">
        <text>{{ depts[currentDeptIndex].dept_name }}</text>
        <text wx:if="{{ !canAddStaff }}" class="dept-disabled-tag">已停用</text>
        <text class="dept-picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 搜索 + 操作按钮：工具卡（控件样式与统计/收费页的筛选卡一致） -->
  <view class="tool-card" wx:if="{{ hasPermission }}">
    <!-- 搜索行：灰底胶囊搜索框（占满剩余宽度）+ 蓝色实心「查询」按钮，高度与统计页查询按钮对齐（58rpx） -->
    <view class="tool-search-row">
      <view class="search-box">
        <van-icon name="search" size="16px" color="#969799" />
        <input
          class="search-input"
          type="text"
          value="{{ searchKey }}"
          placeholder="请输入姓名或手机号"
          placeholder-style="color:#969799;font-size:28rpx;"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onStaffSearch"
        />
        <van-icon
          wx:if="{{ searchKey }}"
          name="clear"
          size="14px"
          color="#c8c9cc"
          bindtap="onStaffClear"
        />
      </view>
      <van-button
        type="primary"
        size="mini"
        custom-style="width:112rpx;height:58rpx;padding:0;font-size:26rpx;flex-shrink:0;box-sizing:border-box;line-height:58rpx;"
        bindtap="onStaffSearch"
      >查询</van-button>
    </view>
    <view class="tool-actions">
      <view
        class="ws-btn-style {{ canAddStaff ? '' : 'ws-btn-style-disabled' }}"
        hover-class="{{ canAddStaff ? 'ws-btn-style-hover' : 'none' }}"
        bindtap="onBatchImport"
      >批量导入</view>
      <!-- 当前所选部门停用（sys_dept.status=0）时禁用新增：后端 addStaff 同样会拒绝 -->
      <view
        class="ws-btn-style {{ canAddStaff ? '' : 'ws-btn-style-disabled' }}"
        hover-class="{{ canAddStaff ? 'ws-btn-style-hover' : 'none' }}"
        bindtap="onAddStaff"
      >新增员工</view>
    </view>
  </view>

  <!-- 员工列表：第一行 姓名+部门+角色(右)，第二行 手机号，第三行 状态徽章+编辑按钮 -->
  <view class="staff-list" wx:if="{{ hasPermission && staffList.length }}">
    <view class="staff-item" wx:for="{{ staffList }}" wx:key="id">
      <view class="staff-head">
        <view class="staff-head-left">
          <text class="staff-name">{{ item.name }}</text>
          <view class="staff-dept-tag">{{ item.dept_name }}</view>
        </view>
        <text class="staff-role" wx:if="{{ item.role_name }}">{{ item.role_name }}</text>
      </view>
      <view class="staff-phone-row">
        <text class="staff-phone">{{ item.phone || '—' }}</text>
      </view>
      <!-- 第三行：左（启用/禁用、绑定状态徽章）右（编辑按钮，样式对齐新增员工） -->
      <view class="staff-status">
        <view class="status-left">
          <view class="badge {{ item.status === 1 ? 'badge-green' : 'badge-red' }}">
            {{ item.status === 1 ? '启用' : '禁用' }}
          </view>
          <view class="badge {{ item.has_openid ? 'badge-blue' : 'badge-gray' }}">
            {{ item.has_openid ? '已绑定' : '未绑定' }}
          </view>
        </view>
        <!-- deptAdmin 对管理级身份（deptAdmin / sysAdmin）无任何可操作项，不显示编辑按钮 -->
        <view
          wx:if="{{ operatorCode === 'sysAdmin' || (item.role_code !== 'deptAdmin' && item.role_code !== 'sysAdmin') }}"
          class="staff-edit-btn"
          hover-class="staff-edit-btn-hover"
          bindtap="onEditStaff"
          data-id="{{ item.id }}"
        >编辑</view>
      </view>
    </view>
  </view>

  <!-- 空状态 / 加载中 -->
  <view class="empty-wrap" wx:if="{{ hasPermission }}">
    <van-loading wx:if="{{ loading }}" size="24rpx" color="#1989fa" />
    <van-empty
      wx:if="{{ !loading && staffList.length === 0 }}"
      description="暂无员工数据"
    />
  </view>

  <!-- 无权限提示 -->
  <van-empty
    wx:if="{{ !hasPermission }}"
    description="当前账号暂无管理的部门"
    image="search"
  />

</view>

<!-- ─────────── 新增 / 编辑 表单弹窗 ─────────── -->
<van-popup
  show="{{ showForm }}"
  position="bottom"
  round
  closeable
  close-on-click-overlay="{{ !saving }}"
  bind:close="onFormClose"
  safe-area-inset-bottom
>
  <view class="form-sheet" catchtouchmove="onFormNoop">
    <view class="form-title">{{ formTitle }}</view>

    <scroll-view scroll-y class="form-body">
    <!-- 姓名 -->
    <van-cell-group inset custom-class="form-group">
      <van-field
        label="姓名"
        placeholder="请输入员工姓名"
        value="{{ form.name }}"
        data-field="name"
        bind:change="onFormFieldChange"
        maxlength="20"
      />
    </van-cell-group>

    <!-- 手机号（编辑时修改 = 原「改手机号」） -->
    <van-cell-group inset custom-class="form-group">
      <van-field
        label="手机号"
        type="number"
        placeholder="请输入 11 位手机号"
        value="{{ form.phone }}"
        data-field="phone"
        bind:change="onFormFieldChange"
        maxlength="11"
      />
    </van-cell-group>

    <!-- 所属部门 -->
    <view class="form-row">
      <text class="form-label">所属部门</text>
      <picker
        mode="selector"
        range="{{ formDepts }}"
        range-key="dept_name"
        value="{{ formDeptIndex }}"
        disabled="{{ isSelfAccount }}"
        bindchange="onFormDeptChange"
      >
        <view class="form-picker">
          <text class="form-picker-text">{{ formDepts[formDeptIndex].dept_name || '请选择' }}</text>
          <text class="form-picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 账号状态（编辑时同样可在此启用 / 禁用；本人账号不可停用） -->
    <view class="form-row">
      <text class="form-label">账号状态</text>
      <van-switch
        checked="{{ form.status === 1 }}"
        size="24"
        active-color="#1989fa"
        inactive-color="#dcdee0"
        disabled="{{ isSelfAccount }}"
        bind:change="onFormStatusChange"
      />
    </view>

    <!-- 员工身份：可分配角色下拉（样式同「所属部门」；普通员工 + 后端按操作者白名单返回的其他角色） -->
    <view class="form-row">
      <text class="form-label">员工身份</text>
      <picker
        mode="selector"
        range="{{ roles }}"
        range-key="role_name"
        value="{{ rolesIndex }}"
        disabled="{{ loadingRoles || roles.length === 0 }}"
        bindchange="onFormRoleChange"
      >
        <view class="form-picker">
          <text class="form-picker-text">{{ roles[rolesIndex] ? roles[rolesIndex].role_name : (loadingRoles ? '加载中…' : '请选择') }}</text>
          <text class="form-picker-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="form-role-tip" wx:if="{{ form.role_id > 0 && roleTip }}">
      {{ roleTip }}
    </view>

    <!-- 编辑模式：更多操作（重置密码 / 解绑微信 / 删除；编辑本人账号时整块不显示） -->
    <block wx:if="{{ formMode === 'edit' && !isSelfAccount }}">
      <view class="extra-section-title">更多操作</view>
      <view class="extra-action" hover-class="extra-action-hover" bindtap="onResetPassword">
        <view class="extra-action-main">
          <text class="extra-action-name">重置密码</text>
          <text class="extra-action-desc">重新生成随机密码，原密码失效</text>
        </view>
        <van-icon name="arrow" size="16px" color="#c8c9cc" />
      </view>
      <view
        class="extra-action"
        wx:if="{{ form.has_openid }}"
        hover-class="extra-action-hover"
        bindtap="onUnbindWechat"
      >
        <view class="extra-action-main">
          <text class="extra-action-name danger">解绑微信</text>
          <text class="extra-action-desc">解绑后该员工需重新登录</text>
        </view>
        <van-icon name="arrow" size="16px" color="#c8c9cc" />
      </view>
      <view
        class="extra-action"
        hover-class="extra-action-hover"
        bindtap="onDeleteStaff"
      >
        <view class="extra-action-main">
          <text class="extra-action-name danger">删除员工</text>
          <text class="extra-action-desc">仅可删除无报餐记录的员工</text>
        </view>
        <van-icon name="arrow" size="16px" color="#c8c9cc" />
      </view>
    </block>
    </scroll-view>

    <view class="form-actions">
      <van-button
        size="normal"
        plain
        hairline
        type="default"
        bindtap="onFormClose"
        disabled="{{ saving }}"
        custom-class="form-btn"
      >取消</van-button>
      <van-button
        size="normal"
        type="primary"
        loading="{{ saving }}"
        bindtap="onFormSubmit"
        custom-class="form-btn"
      >保存</van-button>
    </view>
  </view>
</van-popup>

<!-- ─────────── 初始密码 / 重置密码展示弹窗 ─────────── -->
<van-popup
  show="{{ showPassword }}"
  round
  closeable
  close-on-click-overlay
  bind:close="onPasswordClose"
>
  <view class="password-sheet">
    <view class="password-title">
      {{ passwordInfo.mode === 'add' ? '新增成功 · 初始密码' : '密码已重置' }}
    </view>
    <view class="password-name">员工：{{ passwordInfo.name }}</view>
    <view class="password-card">
      <text class="password-text">{{ passwordInfo.password }}</text>
      <view
        class="password-copy"
        hover-class="password-copy-hover"
        hover-stay-time="120"
        bindtap="onCopyPassword"
      >
        <van-icon name="description" custom-style="font-size: 26rpx;" />
        <text class="password-copy-text">复制</text>
      </view>
    </view>
    <view class="password-tip">
      请妥善保存，关闭后不再展示
    </view>
    <!-- 去掉 block（否则强制撑满整行），改用固定尺寸并居中，按钮更紧凑 -->
    <van-button
      type="primary"
      size="normal"
      custom-class="password-ok"
      custom-style="width:300rpx;height:64rpx;padding:0;font-size:26rpx;line-height:64rpx;box-sizing:border-box;"
      bindtap="onPasswordClose"
    >我知道了</van-button>
  </view>
</van-popup>

<!-- ─────────── 批量导入弹窗 ─────────── -->
<van-popup
  show="{{ showImport }}"
  position="bottom"
  round
  closeable
  close-on-click-overlay="{{ !importing }}"
  bind:close="onImportClose"
  safe-area-inset-bottom
>
  <view class="form-sheet" catchtouchmove="onImportNoop">
    <view class="form-title">批量导入员工</view>

    <scroll-view scroll-y class="form-body">
    <!-- 所属部门（整批员工统一归属该部门） -->
    <view class="form-row">
      <text class="form-label">所属部门</text>
      <picker
        mode="selector"
        range="{{ importDepts }}"
        range-key="dept_name"
        value="{{ importDeptIndex }}"
        bindchange="onImportDeptChange"
      >
        <view class="form-picker">
          <text class="form-picker-text">{{ importDepts[importDeptIndex].dept_name || '请选择' }}</text>
          <text class="form-picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 员工身份（整批统一身份，默认普通员工） -->
    <view class="form-row">
      <text class="form-label">员工身份</text>
      <picker
        mode="selector"
        range="{{ importRoles }}"
        range-key="role_name"
        value="{{ importRoleIndex }}"
        disabled="{{ loadingImportRoles || importRoles.length === 0 }}"
        bindchange="onImportRoleChange"
      >
        <view class="form-picker">
          <text class="form-picker-text">{{ importRoles[importRoleIndex] ? importRoles[importRoleIndex].role_name : (loadingImportRoles ? '加载中…' : '请选择') }}</text>
          <text class="form-picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 统一初始密码（必填，8-20 位） -->
    <van-cell-group inset custom-class="form-group">
      <van-field
        label="初始密码"
        placeholder="8-20 位字母、数字或符号"
        value="{{ importPassword }}"
        bind:change="onImportPwdInput"
        maxlength="20"
        clearable
      />
    </van-cell-group>

    <view class="import-text-wrap">
      <view class="import-textarea-box">
        <view class="import-textarea-ph" wx:if="{{ !importText }}">
          <view class="import-ph-line">每行一名员工，格式：姓名,手机号。示例：</view>
          <view class="import-ph-line import-ph-sub">张三,13800001111</view>
          <view class="import-ph-line import-ph-sub">李四,13800002222</view>
        </view>
        <textarea
          class="import-textarea"
          value="{{ importText }}"
          maxlength="8000"
          bindinput="onImportTextInput"
        />
      </view>
    </view>

    <!-- 解析预览：有效条数 + 无效行原因（最多展示 5 条） -->
    <view class="import-preview" wx:if="{{ importPreview }}">
      <view class="import-preview-summary">
        共识别 {{ importPreview.total }} 行，可导入 {{ importPreview.validCount }} 名
      </view>
      <view class="import-preview-error" wx:for="{{ importPreview.errors }}" wx:key="line">
        {{ item.message }}
      </view>
      <view class="import-preview-error" wx:if="{{ importPreview.errorMore > 0 }}">
        还有 {{ importPreview.errorMore }} 行存在问题，请修正后再导入
      </view>
    </view>
    </scroll-view>

    <view class="form-actions">
      <van-button
        size="normal"
        plain
        hairline
        type="default"
        bindtap="onImportClose"
        disabled="{{ importing }}"
        custom-class="form-btn"
      >取消</van-button>
      <van-button
        size="normal"
        type="primary"
        loading="{{ importing }}"
        disabled="{{ importing || (importPreview && importPreview.errorCount > 0) }}"
        bindtap="onImportSubmit"
        custom-class="form-btn"
      >导入</van-button>
    </view>
  </view>
</van-popup>

<!-- ─────────── 批量导入失败明细弹窗（仅在有失败行时出现） ─────────── -->
<van-popup
  show="{{ showImportResult }}"
  round
  closeable
  bind:close="onImportResultClose"
>
  <view class="import-result-sheet">
    <view class="password-title">部分员工未导入</view>
    <view class="import-result-summary">
      成功 <text class="import-ok-num">{{ importResult.successCount }}</text> 名，
      失败 <text class="import-fail-num">{{ importResult.failCount }}</text> 名
    </view>
    <scroll-view scroll-y class="import-result-list">
      <view
        class="import-result-item"
        wx:for="{{ importResult.failRows }}"
        wx:key="line"
      >
        <view class="import-result-main">
          <text class="import-result-name">{{ item.name || '（空）' }}</text>
          <text class="import-result-phone">{{ item.phone || '—' }}</text>
        </view>
        <view class="import-result-right">
          <text class="import-result-msg">{{ item.message }}</text>
        </view>
      </view>
    </scroll-view>
    <view class="password-tip">请对照原因修改后重新导入</view>
    <view class="import-result-actions">
      <view
        class="import-result-btn import-result-btn-primary"
        hover-class="import-result-btn-hover"
        bindtap="onCopyImportResult"
      >复制失败明细</view>
      <view
        class="import-result-btn"
        hover-class="import-result-btn-hover"
        bindtap="onImportResultClose"
      >我知道了</view>
    </view>
  </view>
</van-popup>

<!-- Vant Dialog 全局实例 -->
<van-dialog id="van-dialog" />
<!--subpackages/admin/pages/location-manage/index.wxml-->

<view class="page-pad">

  <!-- 工具卡：搜索 + 新增食堂按钮 -->
  <view class="tool-card">
    <view class="tool-search-row">
      <view class="search-box">
        <van-icon name="search" size="16px" color="#969799" />
        <input
          class="search-input"
          type="text"
          value="{{searchKey}}"
          placeholder="请输入食堂名称"
          placeholder-style="color:#969799;font-size:28rpx;"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onLocSearch"
        />
        <van-icon
          wx:if="{{searchKey}}"
          name="clear"
          size="14px"
          color="#c8c9cc"
          bindtap="onLocClear"
        />
      </view>
      <van-button
        type="primary"
        size="mini"
        custom-style="width:112rpx;height:58rpx;padding:0;font-size:26rpx;flex-shrink:0;box-sizing:border-box;line-height:58rpx;"
        bindtap="onLocSearch"
      >查询</van-button>
    </view>
    <view class="tool-actions">
      <view
        class="ws-btn-style"
        hover-class="ws-btn-style-hover"
        bindtap="onAdd"
      >新增食堂</view>
    </view>
  </view>

  <view class="group">
    <view class="list">
      <view class="xxx-item" wx:for="{{displayList}}" wx:key="id">
        <view class="item-main">
          <view class="item-title">
            <text>{{item.name}}</text>
            <text class="badge {{item.status === 1 ? 'badge-green' : 'badge-gray'}}">{{item.status === 1 ? '启用' : '停用'}}</text>
          </view>
          <view class="item-sub">
            部门 {{item.dept_count}} 个
          </view>
        </view>
        <view class="item-foot">
          <view class="list-btn" hover-class="list-btn-hover" data-item="{{item}}" bindtap="onEdit">编辑</view>
          <view class="list-btn list-btn-danger" hover-class="list-btn-danger-hover" data-item="{{item}}" bindtap="onDelete">删除</view>
        </view>
      </view>
    </view>

    <view class="empty-wrap">
      <van-loading wx:if="{{loading}}" size="24rpx" color="#1989fa" />
      <van-empty
        wx:if="{{!loading && displayList.length === 0}}"
        description="暂无食堂数据"
      />
    </view>
  </view>
</view>

<!-- 新增 / 编辑食堂 -->
<van-popup
  show="{{showForm}}"
  position="bottom"
  round
  closeable
  close-on-click-overlay="{{!submitting}}"
  bind:close="closeForm"
  safe-area-inset-bottom
>
  <view class="form-sheet" catchtouchmove="noop">
    <view class="form-title">{{form.id ? '编辑食堂' : '新增食堂'}}</view>

    <!-- 食堂名称 -->
    <van-cell-group inset custom-class="form-group">
      <van-field
        label="食堂名称"
        placeholder="请输入食堂名称"
        value="{{form.name}}"
        maxlength="50"
        bind:change="onNameInput"
      />
    </van-cell-group>

    <!-- 状态 -->
    <view class="form-row">
      <text class="form-label">状态</text>
      <van-switch
        checked="{{form.status === 1}}"
        size="24"
        active-color="#1989fa"
        inactive-color="#dcdee0"
        bind:change="onStatusChange"
      />
    </view>

    <view class="form-tip">停用后，员工将无法在该食堂报餐。</view>

    <view class="form-actions">
      <van-button size="normal" plain hairline type="default" bindtap="closeForm" disabled="{{submitting}}" custom-class="form-btn">取消</van-button>
      <van-button size="normal" type="primary" loading="{{submitting}}" bindtap="onSubmit" custom-class="form-btn">保存</van-button>
    </view>
  </view>
</van-popup>

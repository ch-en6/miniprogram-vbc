/* subpackages/admin/pages/location-manage/index.wxss */
@import "../../styles/admin.wxss";

page {
  background: #f5f6f8;
  --brand: #1989fa;
  --brand-dark: #0570db;
  --text-1: #323233;
  --text-2: #646566;
  --text-3: #969799;
  --line: #ebedf0;
}

/* ── 搜索 + 操作工具卡 ── */
.tool-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

/* 搜索行：灰底搜索框（占满）+ 右侧蓝色实心「查询」按钮 */
.tool-search-row {
  display: flex;
  align-items: center;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
  min-width: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  margin: 0 12rpx;
  min-width: 0;
}

/* ── 列表卡片：第一行 食堂名称 + 右侧状态徽章，第二行 部门数·角色绑定数 ── */
.item-main {
  display: block;
}

.item-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.item-title > text:first-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮行：整行按钮，.ws-btn-style（白底 + 1px 蓝框 + 蓝字） */
.tool-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.ws-btn-style {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.3;
  border-radius: 8rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
  background: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
}

.ws-btn-style-hover {
  background: #ecf5ff;
}

/* ── 空态 / 加载中 ── */
.empty-wrap {
  padding: 80rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* ── 表单弹窗：van-popup 底部弹出（覆盖 admin.wxss 中 fixed 定位的旧弹层样式） ── */
.form-sheet {
  position: static;
  z-index: auto;
  max-height: none;
  border-radius: 0;
  background: #fff;
  padding: 0 0 calc(40rpx + env(safe-area-inset-bottom));
}

/* 标题与 van-popup 右上角关闭图标（top 16px + 22px 图标，中心约 27px）保持同一水平线 */
.form-title {
  padding: 32rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.form-group {
  margin: 0 24rpx 16rpx !important;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 0 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.form-tip {
  margin: -6rpx 32rpx 20rpx;
  padding-left: 8rpx;
}

.form-actions {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 24rpx 0;
  border-top: none;
}

.form-btn {
  flex: 1;
}

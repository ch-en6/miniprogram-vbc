/* subpackages/admin/styles/admin.wxss */

/* ── 页面容器（不含底部 tabbar：二级页不挂底部导航） ── */
.page-pad {
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* ── 顶部选择器（与菜单/员工页「当前食堂 / 当前部门」同款） ── */
.dept-selector {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.dept-label {
  font-size: 26rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}
.dept-picker {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

/* ── 分组标题 ── */
.group { margin-bottom: 24rpx; }
.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 8rpx 16rpx;
}
.group-title { font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.group-hint { font-size: 24rpx; color: var(--text-3); }

/* ── 列表（每条独立白卡） ── */
.list { margin-top: 8rpx; }
.xxx-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

/* 卡片头：左（主标题 + 徽章）右（操作按钮） */
.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.3;
}

/* 副标题行（描述信息） */
.item-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* 卡片底部操作区 */
.item-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* ── 状态徽章：浅底深字全圆角（与 dept 三页 badge 同风格） ── */
.badge {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}
.badge-green  { background: #e8f7ef; color: #07c160; }
.badge-gray   { background: #f2f3f5; color: #969799; }
.badge-blue   { background: #eaf3ff; color: var(--brand); }
.badge-orange { background: #fff7e8; color: #ff976a; }
.badge-red    { background: #fef0f0; color: #ee0a24; }

/* ── 列表操作按钮：方形白底 + 1px 蓝框 + 蓝字（与 dept 三页 .list-btn 同款） ── */
.list-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.3;
  border-radius: 8rpx;
  padding: 12rpx 30rpx;
  box-sizing: border-box;
  background: #fff;
  color: var(--brand);
  border: 1rpx solid var(--brand);
  white-space: nowrap;
}
.list-btn-hover { background: #ecf5ff; }
.list-btn-danger {
  color: #ee0a24;
  border-color: #ee0a24;
}
.list-btn-danger-hover { background: #fef0f0; }

/* ── 空 / 加载 ── */
.list-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
.list-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}

/* ── 表单小提示 ── */
.form-tip {
  margin: -6rpx 32rpx 20rpx;
  padding-left: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

/* ── 分段选择（启 / 停） ── */
.seg {
  display: flex;
  flex: 1;
  min-width: 0;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
}
.seg-item {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}
.seg-item.on { background: #fff; color: var(--brand); font-weight: 600; }

/* ── 多选标签（角色绑定食堂） ── */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 4rpx 0; }
.chip {
  padding: 12rpx 26rpx;
  border: 1rpx solid transparent;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #4b5563;
  background: #f2f3f5;
}
.chip.on { color: var(--brand); background: #eaf5ff; border-color: #a8d3ff; }
.chip.disabled { color: #c8c9cc; opacity: .7; }

/* ── 表单右侧整块容器（chips 占据整行时用） ── */
.form-all { flex: 1; min-width: 0; }

/* ── 底部悬浮主按钮（页面底部，非 tabbar） ── */
.fab {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

/* ─────────── 表单弹窗（底部弹出，对齐 dept 三页 .form-sheet） ─────────── */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
  background: rgba(0, 0, 0, .5);
}
.form-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
}
.form-title {
  flex-shrink: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  padding: 32rpx 0 20rpx;
}
.form-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 0 24rpx 16rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
}
.form-label {
  font-size: 28rpx;
  color: var(--text-1);
  flex-shrink: 0;
}
.form-label.req::before {
  content: '*';
  margin-right: 6rpx;
  color: #ee0a24;
}
.form-input { flex: 1; font-size: 28rpx; color: var(--text-1); min-width: 0; }
.form-placeholder { color: #c8c9cc; }
.form-picker {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--text-1);
}
.form-picker.placeholder { color: #c8c9cc; }
.form-picker-arrow {
  font-size: 28rpx;
  line-height: 1;
  color: var(--text-3);
  flex-shrink: 0;
}
.form-actions {
  flex-shrink: 0;
  display: flex;
  gap: 24rpx;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: #fff;
}
.form-btn { flex: 1; }
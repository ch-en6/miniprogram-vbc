/* subpackages/kitchen/pages/today/index.wxss — 食堂今日页面（系统导航栏 + 蓝白主题） */

.kitchen-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 0;
}

/* 个人中心 tab 底部留白更大（cell-group 列表需要更多空间） */
.kitchen-page--profile {
  padding-bottom: 24rpx;
}

/* ─── 报餐查询 Tab ─── */
.search-tab-content {
  padding-top: 16rpx;
}

.search-card {
  margin: 0 20rpx 24rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.search-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 20rpx;
}

.search-input-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

/* 灰底方形搜索框（与部门工作台员工管理页搜索框样式一致） */
.search-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #374151;
  background: transparent;
  margin: 0 12rpx;
  height: 40rpx;
  line-height: 40rpx;
}

.meal-filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meal-filter-label {
  font-size: 24rpx;
  color: #6b7280;
  flex: none;
}

.meal-filter-chips {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.meal-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f5f7fa;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  border: 1px solid #f5f7fa;
}

.meal-chip.active {
  color: #1989fa;
  background: #f0f9ff;
  border-color: #1989fa;
  font-weight: 600;
}

/* ─── 查询结果 ─── */
.search-result-panel {
  padding: 0 24rpx;
}

.search-result-summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f0f9ff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.summary-keyword {
  font-size: 26rpx;
  font-weight: 700;
  color: #1989fa;
}

.summary-count {
  font-size: 24rpx;
  color: #6b7280;
  flex: 1;
}

.summary-date {
  font-size: 22rpx;
  color: #9ca3af;
}

.person-result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.person-card {
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.person-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  border: 1px solid #e5e7eb;
  border-bottom: none;
}

.person-info-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.person-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #374151;
}

.person-dept-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  background: #eef4ff;
  color: #1989fa;
  font-weight: 500;
}

.person-phone {
  font-size: 24rpx;
  color: #9ca3af;
}

.person-meal-body {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-top: none;
  border-radius: 0 0 24rpx 24rpx;
  padding: 8rpx 24rpx 20rpx;
}

.person-meal-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1px dashed #f0f1f3;
}

.person-meal-line:last-child {
  border-bottom: none;
}

/* 餐别标签（圆点 + 文字） */
.meal-label-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meal-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.meal-dot--breakfast {
  background: #f5a623;
}

.meal-dot--lunch {
  background: #1989fa;
}

.meal-dot--dinner {
  background: #c8a6ff;
}

.meal-label-text {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

/* 份数信息 */
.meal-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meal-qty {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.meal-qty--none {
  color: #c0c4cc;
  font-weight: 400;
}

.meal-family {
  font-size: 22rpx;
  color: #f5a623;
  background: #fff8ed;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

/* 核销按钮 */
.verify-btn {
  flex: none;
  width: 120rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1989fa;
  background: #f0f9ff;
  border: 1px solid #1989fa;
  border-radius: 100rpx;
  line-height: 1;
  box-sizing: border-box;
}

.verify-btn--hover {
  opacity: 0.7;
}

.verify-btn--done {
  color: #07c160;
  background: #f0faf2;
  border-color: #07c160;
}

/* 未报餐时右侧占位，保证与核销按钮对齐 */
.verify-placeholder {
  flex: none;
  width: 120rpx;
  height: 44rpx;
  margin-left: 16rpx;
}

.search-empty-tip {
  padding-top: 120rpx;
}

/* ─── 公共 ─── */
.loading-center {
  padding-top: 120rpx;
  display: flex;
  justify-content: center;
}

/* 个人中心「工作台」区块标题（day-summary 组件内同名样式相互隔离，互不影响） */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #374151;
}

/* ─── 个人中心 Tab ─── */
.profile-tab-content {
  padding-top: 16rpx;
}

/* ═══ 员工信息卡片 ═══ */
.emp-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.emp-card-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 20rpx;
  background: linear-gradient(135deg, #1989fa, #4da6ff);
}

.emp-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.emp-avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.emp-header-info {
  flex: 1;
  min-width: 0;
}

.emp-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.emp-dept {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  padding: 4rpx 16rpx;
}

.emp-card-body {
  padding: 20rpx 28rpx 24rpx;
}

.emp-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.emp-info-row:last-child {
  border-bottom: none;
}

.emp-label {
  font-size: 28rpx;
  color: #8c9bad;
}

.emp-value {
  font-size: 28rpx;
  color: #333;
}

.emp-phone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rebind-link {
  font-size: 24rpx;
  color: #1989fa;
  padding: 4rpx 14rpx;
  border: 1px solid #1989fa;
  border-radius: 8rpx;
  line-height: 1.4;
}

.pwd-arrow {
  display: flex;
  align-items: center;
}

/* ═══ 工作台切换 ═══ */
.mini-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.workspace-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: nowrap;
  margin-top: 20rpx;
  align-items: stretch;
}

.workspace-tags .ws-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 12rpx 0;
  line-height: 1.3;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-all;
}

.ws-btn-plain {
  background: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
}

.logout-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-text {
  font-size: 28rpx;
  color: #ee0a24;
}

/* 换绑弹窗 */
.phone-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.42);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.phone-modal-card {
  width: 100%;
  max-height: 92%;
  overflow: auto;
  background: #fff;
  border-radius: 36rpx;
  padding: 24rpx;
  box-shadow: 0 36rpx 80rpx rgba(17, 24, 39, 0.24);
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-weight: 700;
}

.modal-title {
  font-size: 30rpx;
}

.rebind-tip {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.btn-row {
  margin: 24rpx;
}

/* 换绑弹窗内获取验证码按钮 — 限宽避免挤压输入框 */
.sms-btn-mini {
  flex-shrink: 0;
  min-width: 180rpx !important;
  max-width: 200rpx !important;
}

.muted {
  color: #6b7280;
}

/* ─── 底部 4 tab 导航（自绘，仿原生 tabBar） ─── */
.bottom-tabbar-spacer {
  height: 110rpx; /* 与 .bottom-tabbar 高度一致 */
}

.bottom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1px solid #e5e7eb;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 50;
}

.bottom-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 12rpx;
  background: #ffffff;
  transition: background 0.15s ease;
}

.bottom-tab--hover {
  background: #f0f6ff;
}

.bottom-tab__text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #7b8794;
  font-weight: 500;
}

.bottom-tab__text.active {
  color: #1989fa;
  font-weight: 700;
}

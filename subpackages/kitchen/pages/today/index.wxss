/* subpackages/kitchen/pages/today/index.wxss — 食堂今日页面（自定义导航栏 + 蓝白主题） */

.kitchen-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 0;
}

/* 个人中心 tab 底部留白更大（cell-group 列表需要更多空间） */
.kitchen-page--profile {
  padding-bottom: 24rpx;
}

/* ─── 自定义导航栏 ─── */
.custom-navbar {
  position: relative;
  background: #1989fa;
  box-sizing: border-box;
}

.navbar-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.navbar-left {
  width: 120rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
}

.refresh-text {
  font-size: 24rpx;
  color: #fff;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.navbar-right {
  width: 120rpx;
}

/* ─── 报餐查询 Tab ─── */
.search-tab-content {
  padding-top: 16rpx;
}

/* 截止状态徽章（明日报餐日期信息行内） */
.deadline-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-weight: 600;
}

.deadline-tag.expired {
  background: rgba(255,255,255,0.95);
  color: #f56c6c;
}

.search-card {
  margin: 0 20rpx 24rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.search-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 20rpx;
}

.search-mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-mode-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f5f7fa;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
  border: 1px solid #f5f7fa;
}

.search-mode-chip.active {
  color: #1989fa;
  background: #f0f9ff;
  border-color: #1989fa;
  font-weight: 600;
}

.search-input-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.search-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 8rpx;
  height: 60rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  color: #374151;
  background: transparent;
}

.search-input .input-placeholder {
  color: #9ca3af;
}

.search-clear {
  flex: none;
  margin-left: 12rpx;
  padding: 8rpx;
}

.search-btn {
  flex: none !important;
  width: 160rpx !important;
  min-width: 160rpx !important;
  height: 60rpx !important;
  padding: 0 !important;
  font-size: 26rpx !important;
  border-radius: 8rpx !important;
}

.meal-filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meal-filter-label {
  font-size: 24rpx;
  color: #6b7280;
  flex: none;
}

.meal-filter-chips {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.meal-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f5f7fa;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  border: 1px solid #f5f7fa;
}

.meal-chip.active {
  color: #1989fa;
  background: #f0f9ff;
  border-color: #1989fa;
  font-weight: 600;
}

/* ─── 查询结果 ─── */
.search-result-panel {
  padding: 0 24rpx;
}

.search-result-summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f0f9ff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.summary-keyword {
  font-size: 26rpx;
  font-weight: 700;
  color: #1989fa;
}

.summary-count {
  font-size: 24rpx;
  color: #6b7280;
  flex: 1;
}

.summary-date {
  font-size: 22rpx;
  color: #9ca3af;
}

.person-result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.person-result {
  margin-top: 0;
}

.person-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  border: 1px solid #e5e7eb;
  border-bottom: none;
}

.person-info-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.person-name-lg {
  font-size: 34rpx;
  font-weight: 700;
  color: #374151;
}

.person-dept-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  background: #eef4ff;
  color: #1989fa;
  font-weight: 500;
}

.person-search-date {
  font-size: 24rpx;
  color: #9ca3af;
}

.person-phone-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.person-detail-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-top: none;
  border-radius: 0 0 24rpx 24rpx;
  padding: 8rpx 24rpx 24rpx;
}

.person-meal-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px dashed #f0f1f3;
}

.person-meal-line:last-child {
  border-bottom: none;
}

.person-date-label {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.person-meal-status {
  font-size: 26rpx;
  color: #c0c4cc;
  font-weight: 600;
}

.person-meal-status.booked {
  color: #07c160;
}

.search-empty-tip {
  padding-top: 120rpx;
}

/* ─── 日期信息行（Tab 内容顶部） ─── */
.date-info-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #1989fa 0%, #4aa3ff 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.25);
}

.date-info-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.date-info-day {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}

.date-info-week {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* ─── 三餐汇总卡片 ─── */
.meal-summary {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meal-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  border-left: 6rpx solid #1989fa;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.meal-card.breakfast { border-left-color: #f5a623; }
.meal-card.lunch     { border-left-color: #1989fa; }
.meal-card.dinner    { border-left-color: #c8a6ff; }

.meal-card__label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 20rpx;
}

.meal-card__nums {
  display: flex;
  align-items: center;
}

.num-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.num-val {
  font-size: 56rpx;
  font-weight: 900;
  color: #374151;
  line-height: 1;
}

.num-val--highlight {
  color: #1989fa;
}

.num-key {
  font-size: 22rpx;
  color: #9ca3af;
}

.num-divider {
  width: 1px;
  height: 72rpx;
  background: #e5e7eb;
}

/* ─── 部门汇总 ─── */
.dept-section {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.section-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #374151;
}

.view-detail-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #1989fa;
  font-size: 26rpx;
}

.dept-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1px solid #f5f5f5;
}

.dept-card:last-child {
  border-bottom: none;
}

.dept-name {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
  width: 180rpx;
}

.dept-meals {
  display: flex;
  gap: 12rpx;
  flex: 1;
  justify-content: center;
}

.dept-meal-item {
  font-size: 24rpx;
  color: #6b7280;
  background: #f5f7fa;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.dept-total {
  font-size: 26rpx;
  font-weight: 600;
  color: #1989fa;
  text-align: right;
  min-width: 100rpx;
}

/* ─── 公共 ─── */
.loading-center {
  padding-top: 120rpx;
  display: flex;
  justify-content: center;
}

.empty-wrap {
  padding-top: 80rpx;
  margin: 0 24rpx;
}

/* ─── 个人中心 Tab ─── */
.profile-tab-content {
  padding-top: 16rpx;
}

/* ═══ 员工信息卡片 ═══ */
.emp-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.emp-card-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 20rpx;
  background: linear-gradient(135deg, #1989fa, #4da6ff);
}

.emp-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.emp-avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.emp-header-info {
  flex: 1;
  min-width: 0;
}

.emp-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.emp-dept {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  padding: 4rpx 16rpx;
}

.emp-card-body {
  padding: 20rpx 28rpx 24rpx;
}

.emp-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.emp-info-row:last-child {
  border-bottom: none;
}

.emp-label {
  font-size: 28rpx;
  color: #8c9bad;
}

.emp-value {
  font-size: 28rpx;
  color: #333;
}

.emp-phone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rebind-link {
  font-size: 24rpx;
  color: #1989fa;
  padding: 4rpx 14rpx;
  border: 1px solid #1989fa;
  border-radius: 8rpx;
  line-height: 1.4;
}

.pwd-arrow {
  display: flex;
  align-items: center;
}

/* ═══ 工作台切换 ═══ */
.mini-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.workspace-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: nowrap;
  margin-top: 20rpx;
  align-items: stretch;
}

.workspace-tags .ws-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 12rpx 0;
  line-height: 1.3;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-all;
}

.ws-btn-plain {
  background: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
}

.logout-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-text {
  font-size: 28rpx;
  color: #ee0a24;
}

.workspace-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: nowrap;
  margin-top: 20rpx;
  align-items: stretch;
}

.workspace-tags .ws-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 12rpx 8rpx;
  line-height: 1.3;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-all;
}

.workspace-tags .ws-btn-primary {
  background: #1989fa;
  color: #fff;
  border: 1px solid #1989fa;
}

.workspace-tags .ws-btn-plain {
  background: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
}

/* 换绑弹窗 */
.phone-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.42);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.phone-modal-card {
  width: 100%;
  max-height: 92%;
  overflow: auto;
  background: #fff;
  border-radius: 36rpx;
  padding: 24rpx;
  box-shadow: 0 36rpx 80rpx rgba(17, 24, 39, 0.24);
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-weight: 700;
}

.modal-title {
  font-size: 30rpx;
}

.rebind-tip {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.btn-row {
  margin: 24rpx;
}

/* 换绑弹窗内获取验证码按钮 — 限宽避免挤压输入框 */
.sms-btn-mini {
  flex-shrink: 0;
  min-width: 180rpx !important;
  max-width: 200rpx !important;
}

.muted {
  color: #6b7280;
}

/* ─── 底部 4 tab 导航（自绘，仿原生 tabBar） ─── */
.bottom-tabbar-spacer {
  height: 110rpx; /* 与 .bottom-tabbar 高度一致 */
}

.bottom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1px solid #e5e7eb;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 50;
}

.bottom-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 12rpx;
  background: #ffffff;
  transition: background 0.15s ease;
}

.bottom-tab--hover {
  background: #f0f6ff;
}

.bottom-tab__text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #7b8794;
  font-weight: 500;
}

.bottom-tab__text.active {
  color: #1989fa;
  font-weight: 700;
}

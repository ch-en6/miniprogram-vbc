<view class="kitchen-detail-page">
  <!-- 搜索栏 + 餐别筛选：合并为同一白卡，不再分块（搜索框样式同部门工作台员工管理页） -->
  <view class="filter-card">
    <!-- 搜索行 -->
    <view class="search-row">
      <view class="search-box">
        <van-icon name="search" size="16px" color="#969799" />
        <input
          class="search-input"
          type="text"
          value="{{ searchKey }}"
          placeholder="请输入姓名 / 手机号 / 部门"
          placeholder-style="color:#969799;font-size:28rpx;"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearch"
        />
        <van-icon
          wx:if="{{ searchKey }}"
          name="clear"
          size="14px"
          color="#c8c9cc"
          bindtap="onSearchClear"
        />
      </view>
      <van-button
        type="primary"
        size="mini"
        custom-style="width:112rpx;height:58rpx;padding:0;font-size:26rpx;flex-shrink:0;box-sizing:border-box;line-height:58rpx;"
        bindtap="onSearch"
      >查询</van-button>
    </view>

    <!-- 筛选Tab（全部 / 早 / 中 / 晚） -->
    <van-tabs
      active="{{ activeMeal }}"
      color="#1989fa"
      title-active-color="#1989fa"
      bind:change="onMealTabChange"
      sticky
      offset-top="112"
    >
      <van-tab title="全部" name="all" />
      <van-tab title="早餐" name="breakfast" />
      <van-tab title="午餐" name="lunch" />
      <van-tab title="晚餐" name="dinner" />
    </van-tabs>
  </view>

  <!-- 汇总行 -->
  <view class="summary-bar" wx:if="{{ !loading }}">
    <text class="summary-text">共 {{ total }} 人，合计 {{ totalQty }} 份</text>
  </view>

  <!-- ═══ 列表：始终使用 mergedList ═══ -->
  <view class="detail-list" wx:if="{{ !loading }}">
    <view class="person-card" wx:for="{{ mergedList }}" wx:key="id">
      <!-- 人员信息头部 -->
      <view class="person-info-row">
        <view class="person-info-main">
          <text class="person-name">{{ item.name }}</text>
          <text class="person-dept-tag" wx:if="{{ item.deptName }}">{{ item.deptName }}</text>
        </view>
        <text class="person-phone">{{ item.phone }}</text>
      </view>
      <!-- 各餐次明细 -->
      <view class="person-meal-body">
        <view class="person-meal-line" wx:for="{{ item.meals }}" wx:for-item="meal" wx:key="mealType">
          <view class="meal-label-wrap">
            <view class="meal-dot meal-dot--{{ meal.mealType }}"></view>
            <text class="meal-label-text">{{ meal.mealLabel }}</text>
          </view>
          <view class="meal-info">
            <text class="meal-qty">{{ meal.qty }} 份</text>
            <text class="meal-family" wx:if="{{ meal.familyQty > 0 }}">家 {{ meal.familyQty }}</text>
          </view>
          <view
            wx:if="{{ isToday }}"
            class="verify-btn {{ meal.verified === 1 ? 'verify-btn--done' : '' }}"
            hover-class="verify-btn--hover"
            bindtap="onVerifyMeal"
            data-user-id="{{ item.id }}"
            data-meal="{{ meal.mealType }}"
            data-verified="{{ meal.verified }}"
          >
            {{ item.verifyingMeal === meal.mealType ? '处理中…' : (meal.verified === 1 ? '已核销' : '核销') }}
          </view>
          <view wx:else class="verify-placeholder"></view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{ hasMore }}" bindtap="loadMore">
      <van-loading wx:if="{{ loadingMore }}" size="32rpx" color="#1989fa" />
      <text wx:else>加载更多</text>
    </view>
    <view class="no-more" wx:if="{{ !hasMore && mergedList.length > 0 }}">
      <text>已全部加载</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{ !loading && list.length === 0 }}">
    <van-empty description="暂无报餐明细" />
  </view>

  <!-- 加载中 -->
  <view class="loading-center" wx:if="{{ loading }}">
    <van-loading type="spinner" color="#1989fa" size="64rpx" />
  </view>

  <!-- Vant Dialog 组件（函数式调用需要） -->
  <van-dialog id="van-dialog" />
</view>
